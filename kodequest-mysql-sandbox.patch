+  if (/^alter table\b/i.test(s)) {
+    var am = /^alter\s+table\s+`?(\w+)`?\s+([\s\S]*)$/i.exec(stmtText.trim());
+    if (!am) throw new Error("ERROR 1064 (42000): You have an error in your SQL syntax");
