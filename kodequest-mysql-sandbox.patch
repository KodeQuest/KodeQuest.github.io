+        types[c.name] = c.type;
+        if (c.auto) sess.auto[sess.currentDb + "." + tm[1] + "." + c.name] = true;
+      });
+      sess.types[sess.currentDb][tm[1]] = types;
+    }
+    return res;
+  }
