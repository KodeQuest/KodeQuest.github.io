+
+function makeDb(ctx) {
+  var db = new SQL.Database();
+  db.exec("PRAGMA foreign_keys = ON");
+  var i;
+  for (i = 1; i <= 12; i++) {
+    reg(db, "CONCAT", i, function (a) {
+      for (var k = 0; k < a.length; k++) if (a[k] === null) return null;
