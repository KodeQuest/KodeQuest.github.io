          "explain": "Aturan CSS: selektor, kurung kurawal, deklarasi properti: nilai;"
        },
        {
          "id": "css-1-q8",
          "type": "type",
          "prompt": "Ketik aturan untuk class kartu dengan warna latar putih.",
          "preview": "Elemen .kartu berlatar putih",
          "clue": "Class diawali titik. Properti: background-color.",
          "live": {
            "kind": "css",
            "html": "<div style=\"background:#cbd5e1;padding:10px\"><div class=\"kartu\">Kartu</div></div>"
          },
          "answers": [
            ".kartu { background-color: white; }",
            ".kartu { background: white; }"
          ],
          "explain": "Titik (.) menandai class; background-color mengatur warna latar."
