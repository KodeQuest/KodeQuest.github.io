      ]
    },
    {
      "id": "css-2",
      "title": "Box Model",
      "questions": [
        {
          "id": "css-2-q1",
          "type": "mc",
          "prompt": "Urutan lapisan box model dari dalam ke luar:",
          "options": [
            "content, padding, border, margin",
            "content, margin, border, padding",
            "padding, content, border, margin",
            "border, padding, content, margin"
          ],
          "answer": 0,
          "explain": "Isi > padding > border > margin."
        },
        {
          "id": "css-2-q2",
          "type": "mc",
          "prompt": "Properti untuk ruang DI DALAM border adalah…",
          "options": [
            "margin",
            "gap",
            "padding",
            "spacing"
          ],
          "answer": 2,
          "explain": "padding = jarak isi ke border; margin = jarak ke luar."
        },
        {
          "id": "css-2-q3",
          "type": "order",
          "prompt": "Susun aturan kotak.",
          "pieces": [
            ".kotak",
            "{",
            "padding: 16px;",
            "border: 1px solid;",
            "}"
          ],
          "explain": "Beberapa deklarasi bisa berada dalam satu aturan."
        },
        {
          "id": "css-2-q4",
          "type": "order",
          "prompt": "Susun margin otomatis agar rata tengah.",
          "pieces": [
            ".wadah",
            "{",
            "width: 600px;",
            "margin: 0 auto;",
            "}"
          ],
          "explain": "margin 0 auto memusatkan blok yang memiliki lebar."
        },
        {
          "id": "css-2-q5",
          "type": "fill",
          "prompt": "Beri jarak luar 20px.",
          "code": ".a { ___: 20px; }",
          "answers": [
            "margin"
          ],
          "options": [
            "margin",
            "padding",
            "gap",
            "space"
          ],
          "explain": "margin mengatur jarak di luar elemen."
        },
        {
          "id": "css-2-q6",
          "type": "fill",
          "prompt": "Sudut membulat:",
          "code": ".btn { border-___: 8px; }",
          "answers": [
            "radius"
          ],
          "options": [
            "radius",
            "round",
            "corner",
            "curve"
          ],
          "explain": "border-radius membulatkan sudut."
        },
        {
          "id": "css-2-q7",
          "type": "type",
          "prompt": "Ketik aturan .kotak dengan padding 16px.",
          "preview": "Isi kotak berjarak 16px dari tepinya",
          "clue": "padding adalah jarak di dalam border.",
          "live": {
            "kind": "css",
            "html": "<div class=\"kotak\" style=\"background:#c7d2fe;display:inline-block\">Isi</div>"
          },
          "answers": [
            ".kotak { padding: 16px; }"
          ],
          "explain": "padding mengatur jarak isi ke border."
        },
        {
          "id": "css-2-q8",
          "type": "type",
          "prompt": "Ketik aturan .wadah yang membuat blok rata tengah dengan margin otomatis.",
          "preview": "Blok berada di tengah halaman",
          "clue": "Nilai margin: 0 lalu auto.",
          "live": {
            "kind": "css",
            "html": "<div class=\"wadah\" style=\"width:120px;background:#c7d2fe;text-align:center\">Blok</div>",
            "base": ".wadah{border:2px dashed #94a3b8}"
          },
          "answers": [
            ".wadah { margin: 0 auto; }"
          ],
          "explain": "margin: 0 auto memusatkan blok yang memiliki lebar."
        }
      ]
    },
    {
