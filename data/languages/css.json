      "id": "css-1",
      "title": "Selektor & Warna",
      "questions": [
        {
          "id": "css-1-q1",
          "type": "mc",
          "prompt": "Apa fungsi CSS?",
          "options": [
            "Mengatur tampilan halaman",
            "Menyimpan data",
            "Membuat logika program",
            "Mengirim email"
          ],
          "answer": 0,
          "explain": "CSS (Cascading Style Sheets) mengatur tampilan."
        },
        {
          "id": "css-1-q2",
          "type": "mc",
          "prompt": "Selektor untuk elemen ber-class \"kartu\" adalah…",
          "options": [
            "#kartu",
            ".kartu",
            "kartu",
            "*kartu"
          ],
          "answer": 1,
          "explain": "Titik (.) menandai class, tanda pagar (#) menandai id."
        },
        {
          "id": "css-1-q3",
          "type": "order",
          "prompt": "Susun aturan CSS yang benar.",
          "pieces": [
            "p",
            "{",
            "color: red;",
            "}"
          ],
          "explain": "Selektor, kurung kurawal, deklarasi, tutup."
        },
        {
          "id": "css-1-q4",
          "type": "order",
          "prompt": "Susun warna latar.",
          "pieces": [
            "body",
            "{",
            "background-color: #fff;",
            "}"
          ],
          "decoys": [
            "background-color = #fff;"
          ],
          "explain": "Properti dan nilai dipisah titik dua dan diakhiri titik koma."
        },
        {
          "id": "css-1-q5",
          "type": "fill",
          "prompt": "Ubah warna teks menjadi biru.",
          "code": "h1 { ___: blue; }",
          "answers": [
            "color"
