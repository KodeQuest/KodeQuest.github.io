          "options": [
            "color",
            "text",
            "font-color",
            "fill"
          ],
          "explain": "Properti color mengubah warna teks."
        },
        {
          "id": "css-1-q6",
          "type": "fill",
          "prompt": "Selektor id bernama menu:",
          "code": "___menu { margin: 0; }",
          "answers": [
            "#"
          ],
          "options": [
            "#",
            ".",
            "@",
            "&"
          ],
          "explain": "Tanda # dipakai untuk id."
        },
        {
          "id": "css-1-q7",
          "type": "type",
          "prompt": "Ketik aturan CSS agar semua paragraf (p) berwarna merah.",
